#!/bin/sh
# Regenerate graphs for changed data/ folders and include them in the commit.
set -e
folders=$(git diff --cached --name-only --diff-filter=ACMR -- data/ | xargs -n1 dirname 2>/dev/null | sort -u)
[ -n "$folders" ] || exit 0
scripts/generate_graphs.sh $folders
for src in $folders; do git add "docs/graphs/${src#data/}"; done
